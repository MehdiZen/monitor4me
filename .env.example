# monitor4me - environment variables (example, fake values)
#
# NOTE: the project does not load a .env file automatically. These variables are
# read from the process environment (collector: process.env, desktop app: Rust
# std::env). The installer sets INFLUX_TOKEN as a Windows *user* environment
# variable. This file only documents them; copy it to .env for your own tooling
# if you need it (.env is git-ignored). Never commit a real token.

# InfluxDB API token used by the collector (write) and the dashboard (read).
# If unset, both fall back to a built-in development default.
INFLUX_TOKEN=your-influxdb-api-token-here
