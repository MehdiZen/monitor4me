# PowerShell et batch — toujours CRLF sur Windows
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.nsh  text eol=crlf

# Code source — LF universel
*.ts   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.rs   text eol=lf
*.toml text eol=lf

# Binaires — pas de conversion
*.exe  binary
*.zip  binary
*.msi  binary
*.sig  binary
*.ico  binary
*.png  binary

# Statistiques de langages (linguist)
# Les scripts d'installation, de packaging et de release sont de l'outillage :
# ils pèsent plus lourd que le code applicatif et écrasent la barre de langages.
# Exclus des stats, mais toujours versionnés et colorés normalement.
install.ps1                linguist-detectable=false
uninstall.ps1              linguist-detectable=false
monitor4me-install.bat     linguist-detectable=false
scripts/**                 linguist-detectable=false
